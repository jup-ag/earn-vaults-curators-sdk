[package]
name = "{{ crate_name }}"
version = "0.1.0"
edition = "2024"
description = "Autogenerated wincode-based client for the `{{ program_name }}` Solana program"
publish = false

[dependencies]
wincode = { version = "=0.6.3", features = ["derive", "alloc"] }
solana-address = { version = "=2.7.0", features = ["wincode"] }
solana-instruction = "=3.5.1"
