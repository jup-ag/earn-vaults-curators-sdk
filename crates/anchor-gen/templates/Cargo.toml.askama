[package]
name = "{{ crate_name }}"
version = "0.1.0"
edition = "2024"
description = "Autogenerated wincode-based client for the `{{ program_name }}` Solana program"
publish = false

[dependencies]
wincode = { version = "=0.5.5", features = ["derive", "alloc"] }
solana-address = { version = "=2.6.1", features = ["wincode"] }
solana-instruction = "=3.4.0"
